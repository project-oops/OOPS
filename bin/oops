#!/usr/bin/env bash
# oops - the collection's entry point.
#
#   oops build  [project...]      build artefacts
#   oops test   [project...]      run tests
#   oops lint   [project...]      lints at -D warnings
#   oops fmt    [project...]      format in place
#   oops check  [project...]      each project's full gate, as its CI runs it
#   oops clean  [project...]      remove build output
#   oops doc    [project...]      build the API docs
#   oops pkg                      obSCEne's package; variants are make targets:
#                                 oops exec "make pkg-min" obscene
#   oops gates                    the collection gates (tools/check-*.sh)
#   oops all                      gates, then check in every member
#   oops bootstrap [project...]   fetch the members, or the named ones and their deps
#   oops git <args...>            run git in the root and every member
#   oops status                   branch and working-tree state of each repository
#   oops doctor                   whether this machine can build the collection
#   oops setup                    install WSL and the toolchain (tools/setup-wsl.sh)
#   oops exec "<cmd>" [proj...]   run a command in each project
#   oops list                     the members and whether each is present
#   oops tracer <titleid>         capture a title's shaders on hardware and rank the
#                                 translator's gaps; -s <seconds>, -t <target>,
#                                 --out <dir>, --no-ingest, --keep-open
#
# Each verb relays to `<project>/bin/<project>`; this script knows nothing about how a
# project builds. Projects are named in full or by prefix; none means every member. A
# failing project does not stop the others, and the exit code is non-zero if any failed.
# The C repositories need clang and lld; on Windows without them this re-enters through
# WSL, unless OOPS_NO_WSL=1.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(dirname "$HERE")"
# The four projects, then the shared repositories they depend on or that build on them.
PROJECTS="orbistoun obscene prosperous selfish oops-libs oops-sdk oops-apps oops-mesa"

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    BOLD=$'\033[1m'; RED=$'\033[31m'; GREEN=$'\033[32m'; DIM=$'\033[2m'; OFF=$'\033[0m'
else
    BOLD=""; RED=""; GREEN=""; DIM=""; OFF=""
fi

die() { printf '%serror:%s %s\n' "$RED" "$OFF" "$*" >&2; exit 1; }
step() { printf '\n%s=== %s%s\n' "$BOLD" "$*" "$OFF"; }
note() { printf '%s%s%s\n' "$DIM" "$*" "$OFF"; }

is_windows() {
    case "$(uname -s 2>/dev/null || echo unknown)" in
        MINGW*|MSYS*|CYGWIN*) return 0 ;;
        *) return 1 ;;
    esac
}

# True under Git Bash with no clang: the C repositories then build through WSL.
needs_wsl() {
    is_windows || return 1
    command -v clang >/dev/null 2>&1 && return 1
    return 0
}

# The repositories that compile C for the target.
builds_c() {
    case "$1" in obscene|oops-sdk|oops-apps|oops-mesa) return 0 ;; *) return 1 ;; esac
}

# The WSL distributions a toolchain can go in, one per line; empty when there are none.
# `tr` strips the UTF-16 padding. Container runtimes' own appliance distributions (Docker
# Desktop, Rancher, podman) are excluded; tools/setup-wsl.sh keeps the same filter, since it
# runs on machines where this script cannot.
wsl_distros() {
    MSYS_NO_PATHCONV=1 wsl.exe --list --quiet 2>/dev/null | tr -d '\r\0' |
        sed '/^[[:space:]]*$/d' |
        grep -viE '^(docker-desktop(-data)?|rancher-desktop(-data)?|podman-machine.*)$' || true
}

# The distribution to build in, in order of preference:
#
#   1. WSL_DISTRO
#   2. `oops-builder`, the distribution `oops setup` creates
#   3. WSL's default, when it is a usable one (Docker Desktop can be the default)
#   4. the first usable one
#
# tools/setup-wsl.sh picks by the same rule, so setup and builds use one distribution.
wsl_target() {
    if [ -n "${WSL_DISTRO:-}" ]; then printf '%s' "$WSL_DISTRO"; return 0; fi
    local marked usable ours="${OOPS_WSL_NAME:-oops-builder}"
    usable="$(wsl_distros)"
    if grep -qxF "$ours" <<< "$usable"; then
        printf '%s' "$ours"
        return 0
    fi
    marked="$(MSYS_NO_PATHCONV=1 wsl.exe --list --verbose 2>/dev/null | tr -d '\r\0' |
        awk '/^\*/ { print $2; exit }')"
    if [ -n "$marked" ] && grep -qxF "$marked" <<< "$usable"; then
        printf '%s' "$marked"
        return 0
    fi
    printf '%s\n' "$usable" | head -1
}

# Whether a distribution has clang. Time-bounded: a distribution waiting at its first-run
# username prompt blocks every call to it.
wsl_has_clang() {
    local t=""
    command -v timeout >/dev/null 2>&1 && t="timeout 20"
    $t env MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL='*' wsl.exe -d "$1" -- \
        bash -lc 'command -v clang' >/dev/null 2>&1
}

run_via_wsl() {
    local dir="$1"; shift
    [ -n "${OOPS_NO_WSL:-}" ] && die "this needs clang and lld; the shell has neither and OOPS_NO_WSL is set"
    command -v wsl.exe >/dev/null 2>&1 || die "this needs clang and lld. Install WSL, or run this from Linux"
    local distro
    distro="$(wsl_target)"
    [ -n "$distro" ] || die "no WSL distribution to build in. ./bin/oops setup installs one"

    # `cygpath -m`, since wslpath loses the backslashes of `-w` output. `-d "$distro"`,
    # since each distribution mounts the Windows drives in its own place.
    local wpath
    wpath="$(MSYS_NO_PATHCONV=1 wsl.exe -d "$distro" wslpath -a "$(cygpath -m "$dir")" 2>/dev/null | tr -d '\r\0')"
    # Fall back to the default mount root; wslpath honours a `root =` in wsl.conf.
    case "$wpath" in
        /*) ;;
        *) wpath="$(printf '%s' "$dir" | sed 's|^/\([a-zA-Z]\)/|/mnt/\1/|')" ;;
    esac
    [ -n "$wpath" ] || die "could not translate $dir into a WSL path"
    note "via WSL: $distro:$wpath"
    # MSYS_NO_PATHCONV stops Git Bash rewriting `/mnt/c/...` into a Windows path.
    # `~/.cargo/env` puts rustup's cargo ahead of an older distribution-packaged one.
    # shellcheck disable=SC2016 # $HOME expands inside WSL
    MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL='*' wsl.exe -d "$distro" --cd "$wpath" -- \
        bash -lc 'if [ -f "$HOME/.cargo/env" ]; then . "$HOME/.cargo/env"; fi; '"$*"
}

FAILED=""
# Run a command inside a project, print a header, never stop the loop.
run_in() {
    local proj="$1" label="$2"
    shift 2
    local dir="$ROOT/$proj"
    if [ ! -d "$dir" ]; then
        printf '%s%-11s skipped - not checked out (see docs/PUBLISHING.md)%s\n' "$DIM" "$proj" "$OFF"
        return 0
    fi
    step "$proj: $label"
    local status=0
    if builds_c "$proj" && needs_wsl; then
        run_via_wsl "$dir" "$*" || status=$?
    else
        ( cd "$dir" && eval "$*" ) || status=$?
    fi
    if [ "$status" -ne 0 ]; then
        printf '%s%s %s failed (exit %s)%s\n' "$RED" "$proj" "$label" "$status" "$OFF"
        FAILED="$FAILED $proj:$label"
    fi
    return 0
}

report() {
    if [ -n "$FAILED" ]; then
        printf '\n%sfailed:%s' "$RED" "$OFF"
        for f in $FAILED; do printf ' %s' "$f"; done
        printf '\n'
        exit 1
    fi
    printf '\n%sall good%s\n' "$GREEN" "$OFF"
}

# Expand user-supplied names to full project names, by exact match or prefix.
resolve() {
    if [ "$#" -eq 0 ]; then printf '%s' "$PROJECTS"; return 0; fi
    local out="" want hit p
    for want in "$@"; do
        hit=""
        for p in $PROJECTS; do
            case "$p" in "$want"*) hit="$p"; break ;; esac
        done
        [ -n "$hit" ] || die "unknown project '$want'. One of: $PROJECTS"
        out="$out $hit"
    done
    printf '%s' "${out# }"
}

# The command that runs a verb in a project: its own `bin/<project>`. Through `bash`,
# because Windows checkouts drop the executable bit.
cmd_for() {
    local proj="$1" verb="$2"
    [ -f "$ROOT/$proj/bin/$proj" ] || return 1
    printf 'bash ./bin/%s %s' "$proj" "$verb"
}

verb_over_projects() {
    local verb="$1" p c
    shift
    for p in $(resolve "$@"); do
        c="$(cmd_for "$p" "$verb")" || die "no '$verb' defined for $p"
        run_in "$p" "$verb" "$c"
    done
    report
}

# Any git command in the root and every member. Not `git submodule foreach`, which skips
# the root and any member cloned as a plain directory.
git_proxy() {
    [ "$#" -ge 1 ] || die 'git needs arguments: oops git status -s'
    local d name
    for name in "(meta)" $PROJECTS; do
        if [ "$name" = "(meta)" ]; then d="$ROOT"; else d="$ROOT/$name"; fi
        [ -d "$d/.git" ] || continue
        step "$name: git $*"
        git -C "$d" "$@" || FAILED="$FAILED $name:git"
    done
    report
}

# The siblings each project needs checked out beside it: the `path = "../..."` entries of
# its manifests (Cargo.toml, Makefile, app.mk), dev-dependencies included because `check`
# builds tests. Update it when a manifest gains a sibling path.
deps_for() {
    case "$1" in
        obscene)    echo "selfish prosperous oops-libs oops-sdk" ;;
        orbistoun)  echo "oops-libs selfish" ;;
        prosperous) echo "oops-libs selfish" ;;
        selfish)    echo "oops-libs" ;;
        oops-apps)  echo "oops-sdk selfish oops-mesa" ;;
        oops-mesa)  echo "oops-sdk" ;;
        *)          echo "" ;;
    esac
}

# Expand a set of projects to include everything they depend on, transitively.
with_deps() {
    local out="$1" added=1 p d
    while [ "$added" -eq 1 ]; do
        added=0
        for p in $out; do
            for d in $(deps_for "$p"); do
                case " $out " in *" $d "*) ;; *) out="$out $d"; added=1 ;; esac
            done
        done
    done
    printf '%s' "$out"
}

# The published repository name for a project directory. Directories are lower-case,
# as sibling paths are case-sensitive on Linux; repositories use the project spelling.
repo_name() {
    case "$1" in
        orbistoun)  echo "Orbistoun" ;;
        obscene)    echo "obSCEne" ;;
        prosperous) echo "Prosperous" ;;
        selfish)    echo "SELFish" ;;
        oops-libs)  echo "oops-libs" ;;
        oops-sdk)   echo "oops-sdk" ;;
        oops-apps)  echo "oops-apps" ;;
        oops-mesa)  echo "oops-mesa" ;;
        *) return 1 ;;
    esac
}

# The GitHub owner to clone siblings from: OOPS_OWNER, else the owner of the root's
# origin, so a fork bootstraps from the fork.
owner_of() {
    if [ -n "${OOPS_OWNER:-}" ]; then printf '%s' "$OOPS_OWNER"; return 0; fi
    local url
    url="$(git -C "$ROOT" remote get-url origin 2>/dev/null)" || return 1
    # Both forms: https://host/owner/repo(.git) and git@host:owner/repo(.git).
    url="${url%.git}"
    url="${url%/}"
    url="${url%/*}"
    printf '%s' "${url##*[:/]}"
}

# The clone URL for owner/repo. With OOPS_CI_TOKEN set it carries the token, for private
# siblings a workflow's GITHUB_TOKEN cannot read; bootstrap resets the remote afterwards
# so the token is not left in `.git/config`.
clone_url() {
    if [ -n "${OOPS_CI_TOKEN:-}" ]; then
        printf 'https://x-access-token:%s@github.com/%s/%s' "$OOPS_CI_TOKEN" "$1" "$2"
    else
        printf 'https://github.com/%s/%s' "$1" "$2"
    fi
}

# Fetch the named projects and their dependencies (all members when none are named).
# CI clones the root without submodules and bootstraps what its job builds. A member
# already present is kept, since CI checks the project under test out itself; otherwise
# it comes from its submodule entry, or by clone when it has none.
bootstrap() {
    local want p name owner rc
    want="$(with_deps "$(resolve "$@")")"
    owner="$(owner_of)" || owner=""

    for p in $want; do
        if [ -d "$ROOT/$p/.git" ]; then
            printf '  %sok%s   %s already present\n' "$GREEN" "$OFF" "$p"
            continue
        fi
        step "bootstrap $p"
        rc=0
        if [ -f "$ROOT/.gitmodules" ] && grep -q "path = $p\$" "$ROOT/.gitmodules"; then
            # --depth 1: CI wants the tree, never the history.
            git -C "$ROOT" submodule update --init --depth 1 -- "$p" || rc=$?
        elif [ -n "$owner" ] && name="$(repo_name "$p")"; then
            note "not a submodule yet - cloning $owner/$name (docs/PUBLISHING.md)"
            git clone --depth 1 "$(clone_url "$owner" "$name")" "$ROOT/$p" || rc=$?
            # Put the plain URL back, so a token never persists in the clone.
            [ "$rc" -eq 0 ] && git -C "$ROOT/$p" remote set-url origin \
                "https://github.com/$owner/$name" 2>/dev/null || true
        else
            printf '  %s--%s   %s absent, and no owner to clone it from.\n' "$RED" "$OFF" "$p"
            printf '       Set OOPS_OWNER, or give this checkout an origin remote.\n'
            rc=1
        fi
        [ "$rc" -eq 0 ] || FAILED="$FAILED $p:bootstrap"
    done
    report
}

# The checks that span repositories and so run from the root.
gates() {
    step "meta: decision logs"
    bash "$ROOT/tools/check-decisions.sh" || FAILED="$FAILED meta:decisions"
    step "meta: markdown links"
    bash "$ROOT/tools/check-links.sh" || FAILED="$FAILED meta:links"
    step "meta: workflow preambles"
    bash "$ROOT/tools/check-workflows.sh" || FAILED="$FAILED meta:workflows"
    step "meta: dashes"
    bash "$ROOT/tools/check-dashes.sh" || FAILED="$FAILED meta:dashes"
}

status_all() {
    local d name branch dirty state
    for name in "(meta)" $PROJECTS; do
        if [ "$name" = "(meta)" ]; then d="$ROOT"; else d="$ROOT/$name"; fi
        if [ ! -d "$d/.git" ]; then
            printf '%-12s %s\n' "$name" "not a checkout"
            continue
        fi
        # `branch --show-current` also answers in a repository with no commits.
        branch="$(git -C "$d" branch --show-current 2>/dev/null)"
        [ -n "$branch" ] || branch="(detached)"
        dirty="$(git -C "$d" status --porcelain 2>/dev/null | wc -l | tr -d ' ')"
        if [ "$dirty" = "0" ]; then state="clean"; else state="$dirty changed"; fi
        printf '%-12s %-20s %s\n' "$name" "$branch" "$state"
    done
}

doctor() {
    local rc=0 p
    have() {
        if command -v "$1" >/dev/null 2>&1; then
            printf '  %sok%s   %-7s %s\n' "$GREEN" "$OFF" "$1" "$("$1" --version 2>/dev/null | head -1)"
        else
            printf '  %s--%s   %-7s missing - %s\n' "$RED" "$OFF" "$1" "$2"; return 1
        fi
    }

    step "toolchain"
    have cargo "the three Rust projects need it: https://rustup.rs" || rc=1
    have git "needed to resolve what is ignored" || rc=1

    step "the C toolchain - obSCEne, oops-sdk and oops-apps"
    local c_gap=0
    if needs_wsl; then
        if ! command -v wsl.exe >/dev/null 2>&1; then
            printf '  %s--%s   no clang and no WSL - the C repositories cannot be built here\n' "$RED" "$OFF"
            c_gap=1
        elif [ -n "$(wsl_distros)" ]; then
            local d
            d="$(wsl_target)"
            if wsl_has_clang "$d"; then
                note "  no clang in this shell; the C repositories will be built through WSL ($d)"
            else
                printf '  %s--%s   WSL has %s and it carries no clang - nothing builds in it yet\n' "$RED" "$OFF" "$d"
                c_gap=1
            fi
        else
            printf '  %s--%s   no clang, and WSL has no distribution - the C repositories cannot be built here\n' "$RED" "$OFF"
            c_gap=1
        fi
    else
        have clang "the C repositories compile freestanding C with it" || c_gap=1
        have make "obSCEne, oops-sdk and every app are Makefiles" || c_gap=1
    fi
    if [ "$c_gap" -ne 0 ]; then
        note "       ./bin/oops setup installs it (tools/setup-wsl.sh)"
        rc=1
    fi

    step "the collection"
    for p in $PROJECTS; do
        if [ -d "$ROOT/$p" ]; then
            printf '  %sok%s   %s\n' "$GREEN" "$OFF" "$p"
        else
            printf '  %s--%s   %s not checked out - see docs/PUBLISHING.md\n' "$RED" "$OFF" "$p"; rc=1
        fi
    done

    if [ "$rc" -eq 0 ]; then printf '\n%sready%s\n' "$GREEN" "$OFF"
    else printf '\n%ssomething is missing%s\n' "$RED" "$OFF"; fi
    return "$rc"
}

# oops tracer <titleid>: builds the tracer payload (app.mk), launches the title and sends
# the tracer with pros, pulls the shader dumps, and runs orbistoun's shader census over
# them, which ranks the RDNA2 instructions the translator lacks. The dumps are the title's
# own bytecode: local input only, kept under orbistoun's ignored `titles/<id>/`.
cmd_tracer() {
    local id="" target="" seconds=45 out="" ingest=1 keep_open=0
    while [ "$#" -gt 0 ]; do
        case "$1" in
            -t|--target)  target="$2"; shift 2 ;;
            -s|--seconds) seconds="$2"; shift 2 ;;
            --out)        out="$2"; shift 2 ;;
            --no-ingest)  ingest=0; shift ;;
            --keep-open)  keep_open=1; shift ;;
            -h|--help)
                note "oops tracer <titleid> [-s seconds] [-t target] [--out dir] [--no-ingest] [--keep-open]"
                return 0 ;;
            -*) die "tracer: unknown option '$1'" ;;
            *)  if [ -z "$id" ]; then id="$1"; shift; else die "tracer: unexpected argument '$1'"; fi ;;
        esac
    done
    [ -n "$id" ] || die "tracer needs a title id: oops tracer PPSA02664"

    local tracer_dir="$ROOT/oops-apps/src/tracer"
    local elf="$tracer_dir/build/tracer.elf"
    local pros="$ROOT/prosperous/bin/prosperous"
    local remote="/data/shaders"        # shader_dump.c's default dump directory on the target
    out="${out:-$ROOT/orbistoun/titles/$id/shaders}"
    [ -x "$pros" ] || die "prosperous not found at $pros - is the collection checked out? (oops bootstrap)"
    [ -d "$tracer_dir" ] || die "tracer sources not found at $tracer_dir"

    # A pros call with the chosen target; `--name` is a global option.
    p() { if [ -n "$target" ]; then "$pros" "$@" --name "$target"; else "$pros" "$@"; fi; }

    step "build the tracer payload (make elf)"
    if needs_wsl; then run_via_wsl "$tracer_dir" make elf
    else ( cd "$tracer_dir" && make elf ); fi
    [ -f "$elf" ] || die "tracer build produced no $elf"

    step "check the target"
    p check || die "target not reachable - register and check it with prosperous first"

    # The tracer finds the title itself (the process that loaded libSceAgc), so `send` takes
    # no title. It captures shaders created after it attaches: play into a scene during the
    # window to capture more than the launch set.
    step "launch $id"
    p launch "$id" || die "could not launch $id"
    step "inject the tracer (elfldr) and listen while it hooks and dumps (${seconds}s)"
    p send "$elf" --seconds "$seconds" || die "could not send the tracer payload"

    step "watch the log while shaders accumulate (${seconds}s)"
    p logs --seconds "$seconds" || note "log stream ended early"

    step "pull the shader dumps -> $out"
    mkdir -p "$out"
    p backup "$remote" --into "$out" \
        || die "could not pull $remote - did the tracer dump anything? read the log above"

    if [ "$keep_open" -eq 0 ]; then
        step "close $id"
        p close "$id" || note "close reported a problem; the title may still be open"
    fi

    # The census hashes each shader's content, so the dump filenames do not matter.
    if [ "$ingest" -eq 1 ]; then
        step "census: rank the translator's gaps over the captured corpus"
        ( cd "$ROOT/orbistoun" && cargo run -q -p orbistoun-cli -- shaders "$out" )
    else
        note "skipping ingest; run it with:"
        note "  ( cd orbistoun && cargo run -q -p orbistoun-cli -- shaders '$out' )"
    fi

    step "done"
    note "shaders: $out   (local coverage corpus, never committed)"
}

# The header comment is the usage text, up to the `set -euo` line.
usage() {
    local last
    last=$(( $(grep -n '^set -euo' "$0" | head -1 | cut -d: -f1) - 1 ))
    sed -n "2,${last}p" "$0" | sed 's/^#\{1,\} \{0,1\}//'
}

cmd="${1:-}"
if [ "$#" -gt 0 ]; then shift; fi
case "$cmd" in
    build|test|lint|fmt|check|clean|doc) verb_over_projects "$cmd" "$@" ;;
    pkg)     verb_over_projects pkg "${@:-obscene}" ;;
    git)     git_proxy "$@" ;;
    bootstrap) bootstrap "$@" ;;
    gates)   gates; report ;;
    all)     gates; for p in $(resolve); do run_in "$p" check "$(cmd_for "$p" check)"; done; report ;;
    status)  status_all ;;
    doctor)  doctor ;;
    setup)   bash "$ROOT/tools/setup-wsl.sh" "$@" ;;
    tracer)  cmd_tracer "$@" ;;
    list)
        for p in $PROJECTS; do
            if [ -d "$ROOT/$p" ]; then s="present"; else s="absent"; fi
            printf '%-12s %-44s %s\n' "$p" "$ROOT/$p" "$s"
        done ;;
    exec)
        [ "$#" -ge 1 ] || die 'exec needs a command: oops exec "git status -s"'
        c="$1"; shift
        for p in $(resolve "$@"); do run_in "$p" "exec" "$c"; done
        report ;;
    ""|-h|--help|help) usage ;;
    *) die "unknown command '$cmd'. Try: oops --help" ;;
esac
